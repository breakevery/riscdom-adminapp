# Environment variables
.env
.env.*
!.env.example

# Rust build output
/target
**/target

# Node / Vite
node_modules/
# Build outputs: the *contents* are ignored, not the directory itself, so the one
# file that has to be tracked below can be re-included (git cannot re-include a
# file inside an excluded directory).
dist/*
!/dist/.gitkeep

# Tauri generated
/src-tauri/gen/schemas

# OS
.DS_Store
Thumbs.db

# Temporary files
cowork-temp/
*.log
