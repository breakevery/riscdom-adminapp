# Environment variables
.env
.env.*
!.env.example

# Rust build output
/target
**/target

# Node / Vite
node_modules/
# Build outputs: the *contents* are ignored, not the directory itself, so the one
# file that has to be tracked below can be re-included (git cannot re-include a
# file inside an excluded directory).
dist/*
!/dist/.gitkeep

# Tauri generated
/src-tauri/gen/schemas

# Mobile shell (v1.x batch ED-8): the generated Android project and its build tree.
# `tauri android init` writes `gen/android`; batch ED-9 decides whether to commit it.
/mobile-tauri/gen/
/mobile-tauri/target/

# OS
.DS_Store
Thumbs.db

# Temporary files
cowork-temp/
*.log
