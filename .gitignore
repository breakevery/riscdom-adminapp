# Environment variables
.env
.env.*
!.env.example

# Rust build output
/target
**/target

# Node / Vite
node_modules/
# Build outputs: the *contents* are ignored, not the directory itself, so the one
# file that has to be tracked below can be re-included (git cannot re-include a
# file inside an excluded directory).
dist/*
!/dist/.gitkeep

# Tauri generated
/src-tauri/gen/schemas

# Mobile shell (v1.x batches ED-8/ED-9a): the generated Android project under
# `mobile/src-tauri/gen/android` **is committed** -- it is the Android app. The schemas
# `tauri-build` rewrites on every build, and the build tree, are not.
/mobile/src-tauri/gen/schemas
/mobile/src-tauri/target/

# OS
.DS_Store
Thumbs.db

# Temporary files
cowork-temp/
*.log
